
{
  "expo": {
    "name": "Abinarth Formation",
    "slug": "abinarth-formation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/efaec100-f453-40a0-ac5b-6ba85628e3ad.jpeg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/efaec100-f453-40a0-ac5b-6ba85628e3ad.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e27"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abinarth.formation",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/efaec100-f453-40a0-ac5b-6ba85628e3ad.jpeg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/efaec100-f453-40a0-ac5b-6ba85628e3ad.jpeg",
        "backgroundColor": "#0a0e27"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.abinarth.formation",
      "icon": "./assets/images/efaec100-f453-40a0-ac5b-6ba85628e3ad.jpeg"
    },
    "web": {
      "favicon": "./assets/images/efaec100-f453-40a0-ac5b-6ba85628e3ad.jpeg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0e27",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "abinarth",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
