{
  "name": "Natively",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "preview:android": "eas build --platform android --profile preview",
    "preview:ios": "eas build --platform ios --profile preview",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "reset": "rm -rf node_modules/.cache && rm -rf .expo && expo start --clear",
    "clean": "rm -rf node_modules/.cache && rm -rf .expo && rm -rf .metro && rm -rf android && rm -rf ios",
    "deploy": "npm run clean && npm install && eas build --platform all --profile production"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.9",
    "@expo/metro-runtime": "~6.1.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.81.1",
    "expo": "~54.0.1",
    "expo-blur": "^15.0.6",
    "expo-constants": "~18.0.8",
    "expo-font": "^14.0.7",
    "expo-haptics": "^15.0.6",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "^8.0.7",
    "expo-network": "^8.0.7",
    "expo-router": "^6.0.0",
    "expo-splash-screen": "^31.0.8",
    "expo-status-bar": "~3.0.7",
    "expo-symbols": "^1.0.6",
    "expo-system-ui": "^6.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "metro-minify-terser": "^0.83.3",
    "typescript": "^5.9.3"
  },
  "private": true
}
